NUXT_MASSPAY_BASE_URL='https://api.masspay.io/v1.0.0'
NUXT_MASSPAY_API_KEY='your masspay sandbox api key'
NUXT_MASSPAY_WEBHOOK_SECRET='your masspay webhook signing secret (from the client dashboard API section)'
NUXT_MASSPAY_BENEFICIARY_USER_TOKEN='usr_...  (the user_token receiving the PYG payout)'
NUXT_MASSPAY_DESTINATION_TOKEN='dst_...  (MassPay -> Paraguay -> Bank Deposit -> SIPAP, from CatalogService.getCountryServices)'
NUXT_MASSPAY_ATTR_SET_TOKEN='attr_set_...  (beneficiary bank account attrs stored via AttributeService.storeAttrs for the destination above)'
NUXT_MASSPAY_SOURCE_CURRENCY='USD'
